# Copy to .env and replace secrets/host details for your environment.
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET

# Optional local assets. Defaults are repository-relative when omitted.
LOCAL_MEDGEMMA_PATH=backend/models/medgemma-4b-it
