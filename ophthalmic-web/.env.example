# Dataset roots used to rebase legacy absolute paths in metadata/*.csv.
OPHTHALMIC_CATARACT_DATA_ROOT=Data
OPHTHALMIC_CROPPED_DATA_ROOT=Data_Cropped
OPHTHALMIC_AUTODETECT_DATASET_DIR=autoDetect/dataset
